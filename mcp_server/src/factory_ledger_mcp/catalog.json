          },
          "mode": {
            "type": "string",
            "enum": [
              "preview"
            ],
            "default": "preview",
            "description": "Preview only; no save tool is available."
          },
          "ship_all": {
            "type": "boolean",
            "default": false,
            "description": "Preview all remaining lines in full. Cannot be true when lines is supplied."
          },
          "lines": {
            "type": "array",
            "description": "Explicit per-line quantities. Requires ship_all to be false or omitted.",
            "items": {
              "type": "object",
              "required": [
                "line_id",
                "quantity_lb"
              ],
              "properties": {
                "line_id": {
                  "type": "integer"
                },
                "quantity_lb": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional event time. Omit when the shipment happened just now. If the operator implies it happened earlier, ask 'When did this happen?' and pass an ISO 8601 America/New_York plant-local time (an explicit offset is also accepted)."
          },
          "backfill": {
            "type": "boolean",
            "default": false,
            "description": "Set true only for an intentional occurred_at more than 14 days old. The entry will be marked backfilled."
          }
        },
        "required": [
          "order_id",
          "mode"
        ],
        "additionalProperties": false
      }
