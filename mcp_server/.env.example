# Safe hosted default. No env file is loaded automatically.
MCP_ENV=staging
MCP_WRITES_ENABLED=false
MCP_AUTH_MODE=locked
MCP_LEDGER_API_URL=https://fastapi-staging-production-dd7b.up.railway.app
PORT=8000

# Activation is documented in ../docs/mcp-staging-setup.md.
# Set Google credentials, a random token secret and personal staging actor keys
# only in the new staging service's Variables panel, never in this repository.
# MCP_PUBLIC_URL=https://factory-ledger-mcp-staging-production.up.railway.app
# MCP_ALLOWED_USERS=[{"email":"person@example.invalid","role":"floor","actor_key_env":"MCP_ACTOR_KEY_PERSON","actor_id":123,"actor_name":"Synthetic Person","actor_role":"floor"}]

# Optional synthetic local demonstration (replace the settings above):
# MCP_ENV=local
# MCP_AUTH_MODE=local_stub
# MCP_DEV_TOKEN=local-only-demo-token
# MCP_DEV_ROLE=reader
# MCP_LEDGER_API_URL=http://127.0.0.1:8100
# Never use real credentials with the demo; no identity is bound by default.
