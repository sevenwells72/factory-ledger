# Local development only. These are synthetic credentials, not production keys.
# No .env file is loaded automatically; source it explicitly after reviewing it.
MCP_ENV=local
MCP_AUTH_MODE=local_stub
MCP_DEV_TOKEN=local-only-demo-token
MCP_DEV_ROLE=reader
MCP_LEDGER_API_URL=http://127.0.0.1:8100
PORT=8000

# There is no shared backend key. Every ledger request carries the calling user's own
# named-actor key. Against the bundled demo (which checks no key) nothing more is needed.
# Against a separately prepared local ledger with a TEST database, bind one synthetic
# allowlisted user for the stub session, for example:
#   MCP_ALLOWED_USERS=[{"email":"you@example.com","role":"admin_office_floor","actor_key_env":"MCP_ACTOR_KEY_YOU"}]
#   MCP_ACTOR_KEY_YOU=<that test ledger's synthetic named-actor key>
#   MCP_DEV_EMAIL=you@example.com
# Never use a production API key. MCP_TEST_API_KEY was removed and is refused if set.
